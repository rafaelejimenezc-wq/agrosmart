# Copia este archivo como  .streamlit/secrets.toml  y completa los valores.
# NUNCA subas secrets.toml a GitHub.

# ---- Base de datos Neon (obligatoria en la nube) ----
DATABASE_URL = "postgresql://usuario:clave@host/db?sslmode=require"

# ---- Clave para firmar las sesiones ----
AGROSMART_SECRET = "cambia-esto-por-un-texto-largo-y-aleatorio"

# ---- Opción gratuita 1: Google Gemini (AI Studio) ----
AGROSMART_LLM_URL = "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
AGROSMART_LLM_MODEL = "gemini-2.0-flash"
AGROSMART_LLM_KEY = "TU_CLAVE_DE_GOOGLE_AI_STUDIO"

# ---- Opción gratuita 2: Groq ----
